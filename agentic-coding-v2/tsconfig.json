{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"lib": ["ES2023", "DOM", "DOM.Iterable"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
