{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": {
		"includes": [
			"src/**",
			"test/**",
			"scripts/**",
			"biome.json",
			"package.json",
			"tsconfig.json"
		]
	},
	"formatter": { "indentStyle": "tab" },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "noNonNullAssertion": "error" }
		}
	},
	"overrides": [
		{
			"includes": ["src/tui/**/*.tsx"],
			"linter": {
				"rules": { "a11y": { "noStaticElementInteractions": "off" } }
			}
		}
	],
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
