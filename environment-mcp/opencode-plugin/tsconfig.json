{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"jsxImportSource": "@opentui/solid",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"noUncheckedIndexedAccess": false
	},
	"include": ["tui.tsx", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
