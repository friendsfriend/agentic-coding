#!/usr/bin/env bash
set -euo pipefail

[[ -n "${HERDR_ENV:-}" ]] || { echo "herdr-manager must run inside Herdr" >&2; exit 1; }
command -v agentic-coding >/dev/null || { echo "agentic-coding not installed; run: ~/agentic-coding/scripts/install.sh" >&2; exit 1; }

# One merged TUI: workflow list + observability (receiver on 127.0.0.1:4318).
# Ctrl+1 workflow tab, Ctrl+2 observability tab.
exec agentic-coding manager
