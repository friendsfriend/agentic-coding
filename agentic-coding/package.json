{
	"name": "agentic-coding",
	"version": "0.12.7",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"packages/devenv/*",
		"packages/ui"
	],
	"bin": {
		"agentic-coding": "./bin/agentic-coding",
		"devenv": "./bin/devenv"
	},
	"scripts": {
		"test": "bun run scripts/test.ts",
		"test:devenv": "bun test packages/devenv",
		"stage-blocks:generate": "bun run scripts/generate-stage-blocks.ts",
		"stage-blocks:check": "bun run scripts/generate-stage-blocks.ts --check",
		"stage-flows:check": "bun run scripts/check-stage-flows.ts",
		"stage-flows:run": "bun run scripts/stage-flow-run.ts",
		"verify": "bun run lint && bun run type-check && bun run test && bun run test:devenv && bun run build",
		"type-check": "tsc --noEmit",
		"lint": "biome check . && bun run lint:boundaries",
		"format": "biome format --write .",
		"build": "bun run scripts/build.ts",
		"dev:ui": "bun --preload ./node_modules/@opentui/solid/scripts/preload.js src/tui/index.tsx --home",
		"lint:boundaries": "bun test test/workflow-source-layer-boundaries.test.ts test/workflow-repository-family-literals.test.ts test/contracts/boundaries.test.ts test/data/boundaries.test.ts test/dash/viewIsolation.test.ts test/ui/packageBoundaries.test.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-codemode": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@grpc/grpc-js": "^1.14.6",
		"@grpc/proto-loader": "^0.8.1",
		"@opentui/core": "0.7.0",
		"@opentui/keymap": "0.7.0",
		"@opentui/solid": "0.7.0",
		"@ui": "workspace:*",
		"effect": "4.0.6",
		"laya-system-one": "1.3.3",
		"marked": "^18.1.1",
		"playwright-core": "^1.64.1",
		"solid-js": "^1.9.17"
	},
	"devDependencies": {
		"@babel/parser": "^8.0.8",
		"@babel/types": "^8.0.8",
		"@biomejs/biome": "^2.6.3",
		"@playwright/test": "1.64.1",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	},
	"patchedDependencies": {
		"@earendil-works/pi-codemode@1.4.0": "patches/@earendil-works%2Fpi-codemode@1.4.0.patch",
		"@opentui/core@0.7.0": "patches/@opentui%2Fcore@0.7.0.patch"
	}
}
