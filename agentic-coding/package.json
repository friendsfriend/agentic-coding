{
	"name": "agentic-coding",
	"version": "0.12.7",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/devenv/*"
	],
	"bin": {
		"agentic-coding": "./bin/agentic-coding",
		"devenv": "./bin/devenv"
	},
	"scripts": {
		"test": "bun run scripts/test.ts",
		"test:devenv": "bun test packages/devenv",
		"verify": "bun run lint && bun run type-check && bun run test && bun run test:devenv && bun run build",
		"type-check": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"build": "bun run scripts/build.ts",
		"dev:ui": "bun --preload ./node_modules/@opentui/solid/scripts/preload.js src/tui/index.tsx --home",
		"dev:ui-dash": "bun --preload ./node_modules/@opentui/solid/scripts/preload.js src/tui/index.tsx"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.4",
		"@grpc/proto-loader": "^0.8.1",
		"@opentui/core": "0.4.2",
		"@opentui/keymap": "0.4.2",
		"@opentui/solid": "0.4.2",
		"effect": "3.22.2",
		"marked": "^17.0.1",
		"solid-js": "^1.9.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
