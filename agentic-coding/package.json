{
  "name": "agentic-coding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "agentic-coding": "./bin/agentic-coding"
  },
  "scripts": {
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "dev:ui": "bun --preload ./node_modules/@opentui/solid/scripts/preload.js src/tui/index.tsx --home",
    "dev:ui-dash": "bun --preload ./node_modules/@opentui/solid/scripts/preload.js src/tui/index.tsx"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@opentui/core": "0.4.2",
    "@opentui/keymap": "0.4.2",
    "@opentui/solid": "0.4.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
