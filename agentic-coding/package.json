{
	"name": "agentic-coding",
	"version": "0.12.7",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"packages/devenv/*",
		"packages/ui"
	],
	"bin": {
		"agentic-coding": "./bin/agentic-coding",
		"devenv": "./bin/devenv"
	},
	"scripts": {
		"test": "bun run scripts/test.ts",
		"test:devenv": "bun test packages/devenv",
		"verify": "bun run lint && bun run type-check && bun run test && bun run test:devenv && bun run build",
		"type-check": "tsc --noEmit",
		"lint": "biome check . && bun run lint:boundaries",
		"format": "biome format --write .",
		"build": "bun run scripts/build.ts",
		"dev:ui": "bun --preload ./node_modules/@opentui/solid/scripts/preload.js src/tui/index.tsx --home",
		"lint:boundaries": "bun test test/workflow-source-layer-boundaries.test.ts test/workflow-repository-family-literals.test.ts test/contracts/boundaries.test.ts test/data/boundaries.test.ts test/dash/viewIsolation.test.ts test/ui/packageBoundaries.test.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "1.0.0",
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-codemode": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-durable": "1.0.0",
		"@grpc/grpc-js": "^1.14.5",
		"@grpc/proto-loader": "^0.8.1",
		"@opentui/core": "0.5.14",
		"@opentui/keymap": "0.5.14",
		"@opentui/solid": "0.5.14",
		"@ui": "workspace:*",
		"effect": "3.22.2",
		"laya-system-one": "1.3.3",
		"marked": "^18.0.14",
		"solid-js": "^1.9.15"
	},
	"devDependencies": {
		"@babel/parser": "^7.29.9",
		"@babel/types": "^7.29.8",
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
