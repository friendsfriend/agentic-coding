          "provider": "docker",
          "sourcePath": "{{ROOT}}/checkout/chart",
          "kubernetes": {
            "chartPath": "{{ROOT}}/checkout/chart",
            "clusterName": "devenv",
            "contextName": "kind-devenv",
            "namespace": "default",
            "provider": "docker",
            "release": "api",
            "sourcePath": "{{ROOT}}/checkout/chart",
            "wait": {}
          }
        },
        {
          "id": "app/api/run/kubernetes/staging",
          "action": "run",
          "runtime": "kubernetes",
          "label": "Kubernetes staging",
          "profile": "staging",
          "provider": "podman",
          "sourcePath": "{{ROOT}}/config/apps/k8s/api/devenv.k8s.json",
          "requires": [
            {
              "runtime": "kubernetes",
              "profile": "local",
              "infra": "postgres"
            }
          ],
          "kubernetes": {
            "chartPath": "{{ROOT}}/checkout/helm",
            "clusterName": "shop-cluster",
            "contextName": "kind-shop-cluster",
            "image": {
              "pullPolicy": "Never",
              "repository": "shop-api",
              "tag": "latest",
              "valuePaths": {
                "pullPolicy": "image.pullPolicy",
                "repository": "image.repository",
                "tag": "image.tag"
              }
            },
            "namespace": "apps",
            "ports": [
              {
                "localPort": 8080,
                "name": "web",
                "remotePort": 80,
                "resource": "service/api"
              }
            ],
            "provider": "podman",
            "release": "custom",
            "secrets": [
              {
                "keys": [
                  "DB_PASS"
                ],
                "name": "env"
              }
            ],
            "sourcePath": "{{ROOT}}/config/apps/k8s/api/devenv.k8s.json",
            "valuesFiles": [
              "{{ROOT}}/config/apps/k8s/api/values.yaml"
            ],
            "wait": {
              "timeout": "5m"
            }
          }
        },
        {
          "id": "app/api/run/shell/cargo",
          "action": "run",
          "runtime": "shell",
          "label": "cargo run (default for Cargo.toml)",
          "profile": "cargo",
          "launchMode": "tmux",
          "sourcePath": "{{ROOT}}/checkout/Cargo.toml",
          "command": "cargo",
          "args": [
            "run"
          ]
        },
        {
          "id": "app/api/run/shell/go",
          "action": "run",
          "runtime": "shell",
          "label": "go run . (default for go.mod)",
          "profile": "go",
          "launchMode": "tmux",
          "sourcePath": "{{ROOT}}/checkout/go.mod",
          "command": "go",
          "args": [
            "run",
            "."
          ]
        },
        {
          "id": "app/api/run/shell/gradle",
          "action": "run",
          "runtime": "shell",
          "label": "./gradlew run (default for Gradle)",
          "profile": "gradle",
          "launchMode": "tmux",
          "sourcePath": "{{ROOT}}/checkout/gradlew",
          "command": "./gradlew",
          "args": [
            "run"
          ]
        },
