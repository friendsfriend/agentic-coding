{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"jsx": "preserve",
		"jsxImportSource": "@opentui/solid",
		"types": ["@types/bun"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"paths": {
			"@ui": ["./packages/ui/src"],
			"@ui/*": ["./packages/ui/src/*"],
			"@devenv/cli": ["./packages/devenv/cli/src"],
			"@devenv/core": ["./packages/devenv/core/src"],
			"@devenv/types": ["./packages/devenv/types/src"],
			// `agent-definitions/` sits outside this package: the repo-root
			// tsconfig maps the same specifier for bun's runtime resolution.
			"typebox": ["./node_modules/typebox"]
		}
	},
	"include": ["src/**/*", "test/**/*", "scripts/test.ts", "packages/**/*"],
	"exclude": ["test/fixtures/source-layer-boundaries/**/*"]
}
